#!/bin/sh
# Local-only Cudy runtime identity and UCI schema adapter for F9K1103.
#
# Firmware-Unlock donor RE proved that system.board.type is consumed as the
# Cudy operating-mode token (router/ap/re) by description.lua.  It is NOT a
# hardware board identifier.

uci -q get system.board >/dev/null || uci set system.board=board
uci set system.board.type='router'
uci set system.board.workmode='router'
uci set system.board.target='F9K1103'
uci set system.board.model='Belkin F9K1103 Version 1.0'
uci set system.board.rom='F9K1103'

# Cudy-looking login, LEDE-native authentication:
# the web form submits user "admin"; patched LEDE dispatcher verifies the
# password against the existing root account and keeps session identity admin.
uci set luci.main.sysauth='admin'
uci set luci.main.showuser='0'
uci set luci.sauth.defpasswd='0'
uci -q delete luci.sauth.salt

# Disable Cudy cloud planes; no vendor cloud daemon is imported.
[ -e /etc/config/cmagent ] || touch /etc/config/cmagent
[ -e /etc/config/cmsd ] || touch /etc/config/cmsd
uci -q get cmagent.mqtt >/dev/null || uci set cmagent.mqtt=mqtt
uci set cmagent.mqtt.disabled='1'
uci set cmagent.mqtt.broker=''
uci -q get cmsd.cloud >/dev/null || uci set cmsd.cloud=cloud
uci set cmsd.cloud.enabled='0'

# Translate LEDE's generated main AP section names into the Cudy router
# contract.  On this RT3883 family the integrated RT3883 WMAC is the 5 GHz
# radio (radio0) and the PCI RT3091/3092 is explicitly 2.4 GHz (radio1).
# Cudy expects wlan00 = 2.4 GHz main AP and wlan10 = 5 GHz main AP.
for sec in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
    dev="$(uci -q get wireless.$sec.device)"
    mode="$(uci -q get wireless.$sec.mode)"
    [ "$mode" = "ap" ] || continue

    target=""
    case "$dev" in
        radio1) target="wlan00" ;;
        radio0) target="wlan10" ;;
    esac

    [ -n "$target" ] || continue
    [ "$sec" = "$target" ] && continue

    # Only rename the generated primary AP.  Never clobber an existing Cudy
    # section (important for sysupgrade/config restore).
    if ! uci -q get wireless.$target >/dev/null 2>&1; then
        uci rename wireless.$sec="$target"
    fi
done

# LEDE 17.01.5 mac80211 honors wifi-iface.ifname. Make the actual AP netdev
# names match the Cudy userspace contract, not only the UCI section names.
if uci -q get wireless.wlan00 >/dev/null 2>&1; then
    uci set wireless.wlan00.ifname='wlan00'
    uci set wireless.wlan00.device='radio1'
fi
if uci -q get wireless.wlan10 >/dev/null 2>&1; then
    uci set wireless.wlan10.ifname='wlan10'
    uci set wireless.wlan10.device='radio0'
fi

# Metadata consumed by Cudy wireless models. Real capabilities still come from
# the F9K1103 mac80211/iwinfo stack.
uci -q get wireless.radio1 >/dev/null 2>&1 && uci set wireless.radio1.band='2g'
uci -q get wireless.radio0 >/dev/null 2>&1 && uci set wireless.radio0.band='5g'

uci commit system
uci commit luci
uci commit cmagent
uci commit cmsd
uci commit wireless
exit 0
