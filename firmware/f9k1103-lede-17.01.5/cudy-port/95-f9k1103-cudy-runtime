#!/bin/sh
# Local-only Cudy runtime identity and UCI schema adapter for F9K1103.
#
# Firmware-Unlock donor RE proved that system.board.type is consumed as the
# Cudy operating-mode token (router/ap/re) by description.lua.  It is NOT a
# hardware board identifier.

uci -q get system.board >/dev/null || uci set system.board=board
uci set system.board.type='router'
uci set system.board.workmode='router'
uci set system.board.target='F9K1103'
uci set system.board.model='Belkin F9K1103 Version 1.0'
uci set system.board.rom='F9K1103'

# Cudy's donor /bin/config_generate records each logical network role in
# network.<iface>.mode.  The stock LEDE generator on F9K1103 omits this field,
# while the imported Cudy description.lua uses network.wan.mode='wan' to
# resolve WAN UI visibility.  Preserve the target-native WAN interface and add
# only the missing Cudy role metadata.
if uci -q get network.wan >/dev/null 2>&1; then
    uci set network.wan.mode='wan'
fi

# Cudy-looking login, LEDE-native authentication:
# the web form submits user "admin"; patched LEDE dispatcher verifies the
# password against the existing root account and keeps session identity admin.
uci set luci.main.sysauth='admin'
uci set luci.main.showuser='0'
uci set luci.sauth.defpasswd='0'
uci -q delete luci.sauth.salt

# Disable Cudy cloud planes; no vendor cloud daemon is imported.
[ -e /etc/config/cmagent ] || touch /etc/config/cmagent
[ -e /etc/config/cmsd ] || touch /etc/config/cmsd
uci -q get cmagent.mqtt >/dev/null || uci set cmagent.mqtt=mqtt
uci set cmagent.mqtt.disabled='1'
uci set cmagent.mqtt.broker=''
uci -q get cmsd.cloud >/dev/null || uci set cmsd.cloud=cloud
uci set cmsd.cloud.enabled='0'

# Translate LEDE's generated main AP section names into the Cudy router
# contract. TARGET-TEST-01 on the physical F9K1103 proved the actual LEDE
# enumeration:
#   radio0 = pci0000:00/.../0000:01:00.0 = RT3091/3092 = 2.4 GHz
#   radio1 = platform/10180000.wmac       = RT3883 WMAC  = 5 GHz
# Cudy expects wlan00 = 2.4 GHz main AP and wlan10 = 5 GHz main AP.
for sec in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
    dev="$(uci -q get wireless.$sec.device)"
    mode="$(uci -q get wireless.$sec.mode)"
    [ "$mode" = "ap" ] || continue

    target=""
    case "$dev" in
        radio0) target="wlan00" ;;
        radio1) target="wlan10" ;;
    esac

    [ -n "$target" ] || continue
    [ "$sec" = "$target" ] && continue

    # Only rename the generated primary AP.  Never clobber an existing Cudy
    # section (important for sysupgrade/config restore).
    if ! uci -q get wireless.$target >/dev/null 2>&1; then
        uci rename wireless.$sec="$target"
    fi
done

# LEDE 17.01.5 mac80211 honors wifi-iface.ifname. Make the actual AP netdev
# names match the Cudy userspace contract, not only the UCI section names.
if uci -q get wireless.wlan00 >/dev/null 2>&1; then
    uci set wireless.wlan00.ifname='wlan00'
    uci set wireless.wlan00.device='radio0'
fi
if uci -q get wireless.wlan10 >/dev/null 2>&1; then
    uci set wireless.wlan10.ifname='wlan10'
    uci set wireless.wlan10.device='radio1'
fi

# Metadata consumed by Cudy wireless models. Real capabilities still come from
# the F9K1103 mac80211/iwinfo stack.
uci -q get wireless.radio0 >/dev/null 2>&1 && uci set wireless.radio0.band='2g'
uci -q get wireless.radio1 >/dev/null 2>&1 && uci set wireless.radio1.band='5g'

# The exact WR1200/R26 donor creates its primary wlan00/wlan10 APs enabled.
# Its 30_wlan uci-default assigns Cudy SSIDs and psk-mixed security, using the
# board PIN when available and the donor's own 12345678 fallback otherwise.
# Keep F9K1103 PHY/channel/hwmode target-native; port only those userspace
# defaults which are missing from LEDE's mac80211 generator.
bdinfo_mac="$(bdinfo mac 2>/dev/null | tr -d ':\r\n')"
ssid_suffix="$(printf '%s' "$bdinfo_mac" | sed -n 's/.*\(....\)$/\1/p')"
[ -n "$ssid_suffix" ] || ssid_suffix='default'
bdinfo_pin="$(bdinfo pin 2>/dev/null | tr -d '\r\n')"
[ -n "$bdinfo_pin" ] || bdinfo_pin='12345678'
country="$(bdinfo country 2>/dev/null | tr -d '\r\n')"
[ -n "$country" ] || country='US'

if uci -q get wireless.radio0 >/dev/null 2>&1; then
    uci -q delete wireless.radio0.disabled
    uci set wireless.radio0.country="$country"
fi
if uci -q get wireless.radio1 >/dev/null 2>&1; then
    uci -q delete wireless.radio1.disabled
    uci set wireless.radio1.country="$country"
fi

if uci -q get wireless.wlan00 >/dev/null 2>&1; then
    uci -q delete wireless.wlan00.disabled
    uci set wireless.wlan00.i18name='2.4G'
    uci set wireless.wlan00.network='lan'
    uci set wireless.wlan00.mode='ap'
    uci set wireless.wlan00.maxsta='64'
    uci set wireless.wlan00.def_ssid="Cudy-$ssid_suffix"
    uci set wireless.wlan00.ssid="Cudy-$ssid_suffix"
    uci set wireless.wlan00.encryption='psk-mixed'
    uci set wireless.wlan00.key="$bdinfo_pin"
    uci set wireless.wlan00.macfilter='deny'
fi
if uci -q get wireless.wlan10 >/dev/null 2>&1; then
    uci -q delete wireless.wlan10.disabled
    uci set wireless.wlan10.i18name='5G'
    uci set wireless.wlan10.network='lan'
    uci set wireless.wlan10.mode='ap'
    uci set wireless.wlan10.maxsta='64'
    uci set wireless.wlan10.def_ssid="Cudy-$ssid_suffix-5G"
    uci set wireless.wlan10.ssid="Cudy-$ssid_suffix-5G"
    uci set wireless.wlan10.encryption='psk-mixed'
    uci set wireless.wlan10.key="$bdinfo_pin"
    uci set wireless.wlan10.macfilter='deny'
fi

uci commit network
uci commit system
uci commit luci
uci commit cmagent
uci commit cmsd
uci commit wireless
exit 0
