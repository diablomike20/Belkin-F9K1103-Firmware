#!/bin/sh
# CUDY-FIRST logical wireless contract adapter for Belkin F9K1103 v1.
#
# Runs before stock Cudy 30_wlan.
#
# Physical radio driver/config remains target-owned mac80211.
# This script only recreates the logical UCI section contract generated by the
# exact WR1200E R62/2.4.25 donor radio wrappers:
#
#   wlan00  2.4G main AP
#   wlan01  2.4G STA/WISP
#   wlan02  2.4G guest AP
#   wlan10  5G main AP
#   wlan11  5G STA/WISP
#   wlan12  5G guest AP
#
# Stock 99_oem later creates wlan03/wlan13.  The post-default hardware adapter
# translates only their physical ifname values to target mac80211 names.
#
# IMPORTANT:
# - do not replace Cudy 30_wlan;
# - do not set MT7628/MT7663 driver types;
# - do not overwrite target radio path/phy/htmode settings;
# - do not set txpower=100, because mac80211 interprets txpower differently.

find_main_ap_section() {
	local dev="$1"
	local sec mode sdev
	for sec in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
		sdev="$(uci -q get wireless.$sec.device)"
		mode="$(uci -q get wireless.$sec.mode)"
		[ "$sdev" = "$dev" ] || continue
		[ "$mode" = "ap" ] || continue
		echo "$sec"
		return 0
	done
	return 1
}

ensure_main_ap() {
	local dev="$1"
	local target="$2"
	local bandname="$3"
	local ifname="$4"
	local src

	if ! uci -q get wireless.$target >/dev/null 2>&1; then
		src="$(find_main_ap_section "$dev")"
		if [ -n "$src" ] && [ "$src" != "$target" ]; then
			uci rename wireless.$src="$target"
		else
			uci set wireless.$target=wifi-iface
		fi
	fi

	uci set wireless.$target.device="$dev"
	uci set wireless.$target.i18name="$bandname"
	uci set wireless.$target.ifname="$ifname"
	uci set wireless.$target.network='lan'
	uci set wireless.$target.mode='ap'
	uci -q get wireless.$target.maxsta >/dev/null 2>&1 || uci set wireless.$target.maxsta='64'
	uci -q get wireless.$target.macfilter >/dev/null 2>&1 || uci set wireless.$target.macfilter='deny'

	# Stock Cudy main APs are enabled on first boot.
	uci -q delete wireless.$target.disabled
}

ensure_sta() {
	local sec="$1"
	local dev="$2"
	local bandname="$3"
	local ifname="$4"
	local net="$5"

	if ! uci -q get wireless.$sec >/dev/null 2>&1; then
		uci set wireless.$sec=wifi-iface
		uci set wireless.$sec.encryption='none'
		uci set wireless.$sec.disabled='1'
	fi
	uci set wireless.$sec.device="$dev"
	uci set wireless.$sec.i18name="$bandname"
	uci set wireless.$sec.ifname="$ifname"
	uci set wireless.$sec.network="$net"
	uci set wireless.$sec.mode='sta'
}

ensure_guest() {
	local sec="$1"
	local dev="$2"
	local bandname="$3"
	local ifname="$4"

	if ! uci -q get wireless.$sec >/dev/null 2>&1; then
		uci set wireless.$sec=wifi-iface
		uci set wireless.$sec.encryption='none'
		uci set wireless.$sec.disabled='1'
	fi
	uci set wireless.$sec.device="$dev"
	uci set wireless.$sec.i18name="$bandname"
	uci set wireless.$sec.ifname="$ifname"
	uci set wireless.$sec.network='lan'
	uci set wireless.$sec.mode='ap'
	uci -q get wireless.$sec.macfilter >/dev/null 2>&1 || uci set wireless.$sec.macfilter='deny'
	uci set wireless.$sec.multissid='1'
}

# The boot-proven target already supplies physical radio0/radio1 wifi-device
# sections.  Abort without inventing radios if that hardware layer is absent.
uci -q get wireless.radio0 >/dev/null 2>&1 || exit 0
uci -q get wireless.radio1 >/dev/null 2>&1 || exit 0

ensure_main_ap radio0 wlan00 '2.4G' wlan00
ensure_sta    wlan01 radio0 '2.4G' wlan01 wisp
ensure_guest  wlan02 radio0 '2.4G' wlan02

ensure_main_ap radio1 wlan10 '5G' wlan10
ensure_sta    wlan11 radio1 '5G' wlan11 wisp5g
ensure_guest  wlan12 radio1 '5G' wlan12

# Cudy UI/runtime capability metadata may consume these logical fields.
# Keep target mac80211 physical hwmode/htmode/path untouched.
uci set wireless.radio0.band='2g'
uci set wireless.radio1.band='5g'
uci -q get wireless.radio0.hwmodes >/dev/null 2>&1 || uci set wireless.radio0.hwmodes='11bgn'
uci -q get wireless.radio1.hwmodes >/dev/null 2>&1 || uci set wireless.radio1.hwmodes='11anac'

uci commit wireless
exit 0
